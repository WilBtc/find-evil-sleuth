# Copy to .env, fill in values. .env is gitignored.

# Postgres (compose-managed)
PG_HOST=127.0.0.1
PG_PORT=5532
PG_DB=sleuth
PG_USER=sleuth
PG_PASSWORD=changeme-dev-only

# Read-only Postgres URL for the ir-narrator agent (SELECT only; no write access)
# Created by migrations/010_sleuth_ro_role.sql
PG_RO_URL=postgresql://sleuth_ro_user:changeme-ro-dev-only@127.0.0.1:5532/sleuth

# Evidence-store HTTP (for hooks)
ES_HTTP_PORT=8931
ES_BIND=127.0.0.1

# Broker (no HTTP, but reserve port for future debug surface)
SB_DEBUG_PORT=8930

# agent-obs (existing service on insa-server-2)
OBS_URL=http://100.119.146.74:8910

# Embedding service (Ollama on g1-avilion)
EMBED_URL=http://100.116.33.91:11434/api/embed
EMBED_MODEL=nomic-embed-text

# Anthropic — claude --print uses this from the environment
# ANTHROPIC_API_KEY is read from your shell, never written here

# Models
MODEL_DEFAULT=claude-sonnet-4-6
MODEL_VALIDATOR=claude-opus-4-7
MODEL_JUDGE=claude-opus-4-7

# Caps
MAX_CONCURRENT_TOOLS=4
MAX_RUNTIME_PER_CASE_S=7200
COST_HARD_CAP_USD=30
